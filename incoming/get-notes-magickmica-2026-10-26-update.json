edia.s3.amazonaws.com/public/images/4c1a85d4-938a-4c0f-a965-b41b0e45a61e_1254x1254.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-368624979"},{"id":368622813,"date":"2026-10-23T20:48:27.516Z","text":"","likes":6,"restacks":2,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/bb49dcaf-035b-4054-8da8-e09c38a76184_541x171.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-368622813"},{"id":368600700,"date":"2026-10-23T20:18:01.261Z","text":"Silk does not apologize for being smooth.","likes":8,"restacks":1,"replies":0,"image":null,"video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-368600700"},{"id":368480588,"date":"2026-10-23T17:42:12.640Z","text":"“Everyone’s worried about the future. I’m worried about dropping a stitch in 1985 and accidentally unraveling 2026.","likes":15,"restacks":2,"replies":1,"image":"https://substack-post-media.s3.amazonaws.com/public/images/5873e00c-c122-4dc7-856f-d61f40ce42de_1672x940.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-368480588"},{"id":364218764,"date":"2026-10-23T13:48:33.892Z","text":"🕯️✩₊˚.⋆🕸️⋆⁺₊✧🕯️","likes":9,"restacks":1,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/23a7b90f-1599-4569-9041-aa253e8c29da_1456x971.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-364218764"},{"id":368183132,"date":"2026-10-23T11:28:46.085Z","text":"✨","likes":37,"restacks":7,"replies":4,"image":"https://substack-post-media.s3.amazonaws.com/public/images/a5f01f78-ccf6-4f9e-8061-eca903d42fb7_1368x768.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-368183132"},{"id":368002598,"date":"2026-10-23T04:12:00.137Z","text":"✎﹏﹏﹏﹏","likes":14,"restacks":1,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/03a730ff-cd65-41e4-98b0-9f64dcee574d_1448x1086.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-368002598"},{"id":367997884,"date":"2026-10-23T03:53:09.333Z","text":"“The forest is full of wonders, darling. It's the ordinary people you have to watch out for.”","likes":38,"restacks":12,"replies":2,"image":"https://substack-post-media.s3.amazonaws.com/public/images/39ac2076-98bc-4d81-88c0-05890c37c0b8_2336x1760.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367997884"},{"id":367988716,"date":"2026-10-23T03:30:06.796Z","text":"🌛","likes":12,"restacks":4,"replies":4,"image":"https://substack-post-media.s3.amazonaws.com/public/images/98c878a0-2e29-4bb4-ba4d-3367b2d0c051_1024x1024.jpeg","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367988716"},{"id":367828412,"date":"2026-10-22T22:07:46.650Z","text":"The empress stirred her tea clockwise to summon luck… and counterclockwise to summon chaos.","likes":16,"restacks":2,"replies":2,"image":"https://substack-post-media.s3.amazonaws.com/public/images/dc05f113-c407-41fe-b9a4-133044ca4a00_600x473.gif","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367828412"},{"id":367798592,"date":"2026-10-22T21:22:43.629Z","text":"🍓₊˚⊹","likes":15,"restacks":3,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/9b8f0564-2640-430d-90da-9592bdead90f_1680x944.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367798592"},{"id":367785788,"date":"2026-10-22T21:04:21.134Z","text":"🎪⋆𐙚˚🎠⊹🎈♡🎡⋆.ೃ࿔*🍿🎢","likes":10,"restacks":0,"replies":2,"image":"https://substack-post-media.s3.amazonaws.com/public/images/e87655c4-ab48-482a-a404-07868484bb72_940x1672.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367785788"},{"id":367547785,"date":"2026-10-22T18:13:31.413Z","text":"Sneak peak ❄️\n\nWinter 2026-2027","likes":7,"restacks":0,"replies":1,"image":"https://substack-post-media.s3.amazonaws.com/public/images/9c322607-3eac-47db-8cbc-cbc3df7a139d_1254x1254.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367547785"},{"id":367526700,"date":"2026-10-22T16:12:00.161Z","text":"“I stopped asking the universe for a sign. The Moon lit up every screen in Wonderland and spelled my name in stardust.”","likes":21,"restacks":6,"replies":4,"image":"https://substack-post-media.s3.amazonaws.com/public/images/ba2847ba-5e30-4b73-868b-4e5e5f7616b2_1111x1656.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367526700"},{"id":366880208,"date":"2026-10-22T15:22:57.763Z","text":"🔥","likes":26,"restacks":8,"replies":4,"image":"https://substack-post-media.s3.amazonaws.com/public/images/083dc5e2-63e8-4e90-910c-d8fb9c5f0e50_1254x1254.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-366880208"},{"id":367432366,"date":"2026-10-22T14:01:24.820Z","text":"Wonder looks really good on you!","likes":11,"restacks":0,"replies":0,"image":null,"video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367432366"},{"id":367429645,"date":"2026-10-22T13:48:36.531Z","text":"","likes":8,"restacks":2,"replies":1,"image":null,"video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367429645"},{"id":367424944,"date":"2026-10-22T13:42:54.020Z","text":"I protect my peace like a rare ecosystem.","likes":31,"restacks":8,"replies":4,"image":"https://substack-post-media.s3.amazonaws.com/public/images/7e78d69d-3d45-4dee-bf3a-f334e5890c6a_1200x1200.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367424944"},{"id":367219718,"date":"2026-10-22T09:55:00.142Z","text":"Some like it hot. I prefer my magic frosty.","likes":13,"restacks":4,"replies":1,"image":"https://substack-post-media.s3.amazonaws.com/public/images/fd572ead-d90f-4152-b0ed-2a92a56e796d_1027x1531.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367219718"},{"id":367208089,"date":"2026-10-22T06:49:40.227Z","text":"Some endings are just trapdoors installed by the future.","likes":9,"restacks":1,"replies":0,"image":null,"video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367208089"},{"id":367204887,"date":"2026-10-22T06:40:58.583Z","text":"🌛","likes":6,"restacks":1,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/1a503103-a2c5-4008-b83d-caef1719daa8_1334x1179.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367204887"},{"id":367025450,"date":"2026-10-22T00:30:00.342Z","text":"✨","likes":14,"restacks":2,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/fa301f7e-bcd1-41ff-865b-bbe43d95bfd6_1122x1402.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367025450"},{"id":367022446,"date":"2026-10-22T00:00:07.058Z","text":"\"I have been many things in many worlds. In this one, I choose to be alive to the wonder.”","likes":9,"restacks":1,"replies":0,"image":"https://substack-post-media.s3.amazonaws.com/public/images/86be7ee3-521a-4c9f-bc15-f54e86059457_1402x1122.png","video_still":null,"video":null,"link":null,"url":"https://substack.com/@magickmica/note/c-367022446"}]}